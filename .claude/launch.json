{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maneroute-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "maneroute-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3001"],
      "env": { "YOUCAM_MOCK": "1", "NEXT_DIST_DIR": ".next-mock" },
      "port": 3001
    }
  ]
}
